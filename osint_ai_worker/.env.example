# Telegram API Keys
TG_API_ID=telegram_api_id
TG_API_HASH=telegram_api_hash
TG_CHANNELS=telegram_channel1,telegram_channel2,telegram_channel3

# 9Router API (Primary - Default)
ROUTER_API_ENDPOINT=your_router_api_endpoint
ROUTER_API_KEY=your_router_api_key
ROUTER_COMBO_NAME=my-combo

# Gemini API Key (Fallback)
GEMINI_API_KEY=gemini_api_key

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/database_name

# Database Config
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=database_name

DB_HOST=localhost
DB_PORT=5432
DB_USER=user
DB_PASSWORD=password
DB_NAME=database_name

# Deployment Server SSH/SCP Configuration
DEPLOY_HOST=your_ssh_host
DEPLOY_USER=your_ssh_user
DEPLOY_PASSWORD=your_ssh_password
DEPLOY_PORT=22
DEPLOY_PATH=/home/your_ssh_user/osint_ai_worker
NOTEBOOKLM_ACCOUNT=your_notebooklm_account@gmail.com
NOTEBOOKLM_LOCAL_STORAGE=C:\Users\your_user\.notebooklm\profiles\default\storage_state.json
NOTEBOOKLM_REMOTE_STORAGE=/home/your_ssh_user/osint_ai_worker/notebooklm/storage_state.json

# NotebookLM between-session OSINT podcasts
NOTEBOOKLM_PODCAST_ENABLED=false
NOTEBOOKLM_NOTEBOOK=your_notebook_id
NOTEBOOKLM_STORAGE=/app/notebooklm/storage_state.json
NOTEBOOKLM_PROFILE=default
NOTEBOOKLM_SOURCE_DAYS=2
NOTEBOOKLM_AUDIO_LENGTH=default
NOTEBOOKLM_AUDIO_PROMPT=Tạo bản tin podcast tiếng Việt, mạch lạc và súc tích; tổng hợp các tin quan trọng, điểm bất ngờ và tác động có thể xảy ra với vàng, chứng khoán, crypto và forex.

# Ntfy.sh Self-Hosted Push Notification Server
NTFY_PORT=8088
NTFY_BASE_URL=http://localhost:8088
NTFY_TOPIC=trading_signals_alerts
NTFY_NOTIFICATIONS_ENABLED=true
NTFY_TOKEN=
NTFY_CLICK_URL=https://trading-signals-pi.vercel.app/


