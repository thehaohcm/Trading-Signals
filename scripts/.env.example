# Database Configuration
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=trading
DB_PORT=5432

# Slack Webhook URL
# Get this from: https://api.slack.com/messaging/webhooks
# Or from your Slack workspace: Apps → Incoming Webhooks
SLACK_NOTIFICATIONS_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Gemini API Key
GEMINI_API_KEY=gemini_api_key

# BINANCE API Keys
BINANCE_API_KEY=binance_api_key
BINANCE_API_SECRET=binance_api_secret

# Amount in USDT to trade on Binance
BINANCE_TRADE_AMOUNT_USDT=500.0

# Deployment Server SSH/SCP Configuration
DEPLOY_HOST=localhost
DEPLOY_USER=username
DEPLOY_PASSWORD=password
DEPLOY_PORT=port
DEPLOY_PATH=/path/to/Trading-Signals

# Telegram API Keys
TG_API_ID=telegram_api_id
TG_API_HASH=telegram_api_hash
TG_CHANNELS=telegram_channel1,telegram_channel2,telegram_channel3

# Ntfy Push Notification Config (OSINT Server)
NTFY_NOTIFICATIONS_ENABLED=true
NTFY_SERVER_URL=http://localhost:8088
NTFY_TOPIC=trading_signals_alerts
NTFY_TOKEN=
NTFY_CLICK_URL=https://trading-signals-pi.vercel.app/
# Nhắc lại cảnh báo "CHUẨN BỊ VÀO LỆNH / NHỒI LỆNH" mỗi N phút khi giá vẫn cách mốc ≤ 2% mà chưa vượt
# (báo lần đầu khi cách ≤ 1%). 0 = chỉ báo 1 lần; 0.25 = nhắc mỗi 15 giây.
PRE_TRADE_REMINDER_MINUTES=5
# Trạng thái "đã báo" (chống báo trùng, lưu trong DB) tự hết hạn sau N ngày
ALERT_DEDUPE_TTL_DAYS=5

# Sự kiện Breakout Radar (chuẩn bị vào lệnh/nhồi, đã vào/nhồi, cắt lỗ) luôn gửi ntfy bất kể loại tài sản
NTFY_RADAR_ALL_ASSETS=true
# Nhắc lại cảnh báo "Chuẩn bị nhồi lệnh" tối đa N lần (không tính lần đầu)
PRE_PYRAMID_MAX_REMINDERS=3
# Nhắc lại cảnh báo "Chuẩn bị vào lệnh" (tầng 1) tối đa N lần
PRE_TRADE_MAX_REMINDERS=3
