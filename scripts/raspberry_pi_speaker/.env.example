# Địa chỉ server ntfy (cổng 8088 của VPS, xem NTFY_PORT trong osint_ai_worker/docker-compose.yaml)
NTFY_SERVER_URL=http://<IP-VPS>:8088
NTFY_TOPIC=trading_signals_alerts
# NTFY_TOKEN=tk_xxx            # nếu server ntfy bật xác thực

# Thứ tự giọng đọc: gtts (Google, cần internet, tự nhiên) → espeak (offline, giọng máy)
TTS_ENGINES=gtts,espeak

# Giờ yên lặng: chỉ đọc tin KHẨN (cắt lỗ, lỗi lệnh thật). Để trống = đọc 24/24
QUIET_HOURS=23:00-07:00

# Bỏ qua tin cũ hơn N giây (khi Pi mất mạng rồi kết nối lại)
MAX_AGE_SECONDS=300

# Phát tiếng chuông trước khi đọc
CHIME=true

# Đọc "hệ thống đã sẵn sàng" mỗi khi Pi khởi động xong (VD sau khi cắm điện lại)
STARTUP_ANNOUNCE=true

# MAC loa Bluetooth (tuỳ chọn) — tự kết nối lại khi loa ngủ. Xem bằng: bluetoothctl devices
# BT_SPEAKER_MAC=AA:BB:CC:DD:EE:FF
# Kiểm tra & tự kết nối lại loa Bluetooth mỗi N giây (chạy nền)
BT_CHECK_SECONDS=60

# Lệnh phát âm thanh (để trống = tự chọn: paplay/pw-play/aplay cho wav, mpg123 cho mp3)
# AUDIO_PLAYER=
